---
import type { Response } from '@eqtylab/docs/openapi';

import CodeFence from '../components/CodeFence.astro';
import SchemaTree from './SchemaTree.astro';

interface Props {
  responses: Response[];
}

const { responses } = Astro.props;
---

{
  responses.map((r) => (
    <details class="eq-response" open={r.status.startsWith('2')}>
      <summary>
        <code>{r.status}</code>{' '}
        {r.description}
      </summary>
      {r.content.map((c) => (
        <div>
          <p>
            <code>{c.mediaType}</code>
          </p>
          {c.schema && <SchemaTree schema={c.schema} />}
          {c.example !== undefined && (
            <CodeFence code={JSON.stringify(c.example, null, 2)} lang="json" />
          )}
        </div>
      ))}
    </details>
  ))
}
