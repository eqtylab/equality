---
/**
 * The sidebar's rows, one React island on Equality's NavList parts. Groups render open or closed
 * from the server, and closed groups keep their links in the HTML. Until the island hydrates,
 * a group's header does nothing, so the timeout caps that wait on a busy page.
 */
import type { NavNode } from '@eqtylab/docs/types';

import { DocsNavList } from './DocsNavList.tsx';

interface Props {
  nodes: NavNode[];
}

const { nodes } = Astro.props;
---

<DocsNavList nodes={nodes} client:idle={{ timeout: 500 }} />

{/* Without JavaScript a folder's header never opens it, so every folder shows open */}
<noscript>
  <style is:inline>
    [data-slot='nav-list'] li[data-state='closed'] > div {
      grid-template-rows: 1fr !important;
      visibility: visible !important;
    }
    [data-slot='nav-list'] li[data-state='closed'] > div > div > ul {
      opacity: 1 !important;
      translate: none !important;
    }
  </style>
</noscript>
