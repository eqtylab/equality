---
/** Split out so recursion repeats only the list, not the <eq-toc>, <nav>, or heading id. */
import type { TocNode } from '@eqtylab/docs/types';

import styles from './TableOfContents.module.css';

interface Props {
  items: TocNode[];
}

const { items } = Astro.props;
const TocList = Astro.self;
---

<ol class={styles.list}>
  {
    items.map((item) => (
      <li class={styles.item}>
        <a class={styles.link} href={`#${item.slug}`} data-slug={item.slug}>
          {item.text}
        </a>
        {item.children.length > 0 && <TocList items={item.children} />}
      </li>
    ))
  }
</ol>
