---
/** On-this-page navigation. SSR'd so it works without JS; <eq-toc> only adds scroll-spy. */
import type { TocNode } from '@eqtylab/docs/types';

import styles from './TableOfContents.module.css';
import TocList from './TocList.astro';

interface Props {
  items: TocNode[];
  label?: string;
}

const { items, label = 'On this page' } = Astro.props;

function flatten(nodes: TocNode[]): TocNode[] {
  return nodes.flatMap((node) => [node, ...flatten(node.children)]);
}
const slugs = flatten(items).map((n) => n.slug);
---

{
  items.length > 0 && (
    <eq-toc class={styles.toc} data-slugs={slugs.join(',')} data-eq-chrome data-pagefind-ignore>
      <nav aria-labelledby="eq-toc-heading">
        <p class={styles.heading} id="eq-toc-heading">
          {label}
        </p>
        <div class={styles.rails} data-eq-toc-rails>
          {
            /* The lit segment. `eq-toc.ts` measures its path from the rendered rows.
               With no JavaScript it stays empty and the rail is simply unlit. */
          }
          <svg class={styles.rail} aria-hidden="true" fill="none">
            {
              /* Keyed to the path's box, so the colour depends on how far down the rail
                 the segment has reached. Nothing recomputes as it moves. */
            }
            <defs>
              <linearGradient id="eq-toc-rail" x1="0" y1="0" x2="0" y2="1">
                <stop class={styles.railStart} offset="0%"></stop>
                <stop class={styles.railEnd} offset="100%"></stop>
              </linearGradient>
            </defs>
            <path
              data-eq-toc-rail
              stroke="url(#eq-toc-rail)"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <TocList items={items} />
        </div>
      </nav>
    </eq-toc>
  )
}

<script>
  import '@eqtylab/docs/scripts/eq-toc.ts';
</script>
