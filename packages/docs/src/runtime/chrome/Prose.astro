---
/**
 * The article wrapper: page heading, optional deprecation notice, and the prose
 * container.
 *
 * `data-pagefind-body` bounds the search index to real content, so nav labels
 * do not make every page match every query.
 */
import { rewriteHtmlBase } from '@eqtylab/docs/internal/rehype-base-url';
import AlertBridge from '../components/AlertBridge.astro';
import styles from './Prose.module.css';

interface Props {
  title: string;
  description?: string;
  deprecated?: boolean | { message?: string; replacedBy?: string };
  /** URL of the page's markdown twin. Absent when `routing.markdownTwins` is off. */
  markdownHref?: string;
  /** The page's authored MDX, inlined for the copy action. */
  source?: string;
}

const { title, description, deprecated, markdownHref, source } = Astro.props;

const deprecation =
  deprecated === true ? {} : deprecated && typeof deprecated === 'object' ? deprecated : null;

// Authored frontmatter HTML bypasses rehype entirely, so base-prefix it here.
const deprecationMessage = deprecation?.message
  ? rewriteHtmlBase(deprecation.message, import.meta.env.BASE_URL)
  : undefined;
---

<article class="eq-prose" data-eq-prose data-pagefind-body>
  <header class={styles.header} data-eq-chrome>
    <h1 class={styles.title} data-pagefind-meta="title">{title}</h1>
    {description && <p class={styles.description}>{description}</p>}
  </header>

  {
    /**
     * Page actions. `data-pagefind-ignore` because the row sits inside
     * `data-pagefind-body`, and without it every page would match "copy" and
     * "markdown".
     *
     * The source is inlined rather than fetched from the twin on click: it
     * needs no addition to `eq-copy.ts`, it works offline, and it works on a
     * draft page, which renders in dev but has no twin to fetch. Measured cost
     * is 8.4 per cent of gzipped page weight across the demo's 67 pages; the
     * trade flips at about 15 per cent.
     *
     * Not a reason, though it reads like one: `writeText` does require a live
     * user gesture, but WebKit was measured resolving it after an awaited fetch
     * and after a two second delay, so the gesture is not what rules fetching
     * out.
     *
     * Labels follow Cloudflare and Google, which both name the format:
     * Cloudflare's row is "Copy as Markdown / View as Markdown", and Google's
     * Gemini API docs use an icon whose accessible name is "Copy page as
     * markdown". Stripe says "Copy for LLM" instead, and is the outlier of the
     * three references. Naming the format says what lands on the clipboard;
     * naming a consumer dates as fast as the consumer does.
     */
    (source || markdownHref) && (
      <div class={styles.actions} data-eq-chrome data-pagefind-ignore>
        {source && (
          <button
            type="button"
            class={styles.action}
            data-eq-copy={source}
            title="Copies the page source as Markdown"
          >
            <span class={styles.actionLabel} data-eq-copy-idle>
              Copy as Markdown
            </span>
            <span class={styles.actionLabel} data-eq-copy-done>
              Copied
            </span>
          </button>
        )}
        {markdownHref && (
          <a class={styles.action} href={markdownHref}>
            View as Markdown
          </a>
        )}
      </div>
    )
  }

  {
    deprecation && (
      <AlertBridge variant="warning" title="Deprecated">
        {deprecationMessage ? (
          <p set:html={deprecationMessage} />
        ) : (
          <p>This page documents a deprecated feature.</p>
        )}
      </AlertBridge>
    )
  }

  <slot />
</article>

{
  /**
   * The same delegated listener the code fences use. Imported here too because
   * `CodeFence.astro` is the only other importer, so a page with no fenced code
   * would otherwise ship a copy button with nothing driving it. Astro emits one
   * module however many components import it.
   */
}
<script>
  import '@eqtylab/docs/scripts/eq-copy.ts';
</script>
