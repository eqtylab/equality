---
/**
 * Mobile navigation, below `lg` where the sidebar is hidden.
 *
 * The Popover API, not a custom element. With no JavaScript it opens and closes,
 * shuts on Escape or a click outside, returns focus to the button, and paints above
 * everything else. It also avoids `DialogContainer`'s focus-restoration bug.
 */
import CONFIG from 'virtual:eqty-docs/config';
import type { NavNode } from '@eqtylab/docs/types';
import { Icon } from '@eqtylab/equality';

import type { SwitcherData } from '../lib/versions-ui.ts';
import LinkIcon from './LinkIcon.astro';
import NavProduct from './NavProduct.astro';
import NavTree from './NavTree.astro';
import styles from './NavDrawer.module.css';

interface Props {
  nodes: NavNode[];
  /** Absent when versioning is dormant or off. */
  switcher?: SwitcherData;
}
const { nodes, switcher } = Astro.props;
---

<div id="eq-nav-drawer" popover class={styles.drawer} data-eq-chrome data-pagefind-ignore>
  <nav class={styles.panel} aria-label="Documentation">
    <NavProduct />
    {
      switcher && (
        <div class={styles.versions} data-eq-versions>
          <p class={styles.versionsLabel}>Version</p>
          <a
            class={styles.versionLink}
            href={switcher.latest.href}
            data-current={switcher.latest.current ? '' : undefined}
          >
            {switcher.latest.label}
          </a>
          {switcher.groups.map((group) =>
            group.items.map((item) => (
              <a
                class={styles.versionLink}
                href={item.href}
                data-current={item.current ? '' : undefined}
              >
                {item.label}
              </a>
            ))
          )}
        </div>
      )
    }
    {
      /* Relocated from the header bar. Left there, a link with no icon renders
         nameless below `sm`, because the label is hidden and Equality's Icon is
         Lucide-backed, which ships no brand marks. In here the label always shows. */
      CONFIG.header.links.map((link) => (
        <a
          class={styles.link}
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.icon && <LinkIcon icon={link.icon} />}
          <span>{link.label}</span>
          {link.external && <Icon icon="ArrowUpRight" size="xs" />}
        </a>
      ))
    }
    <NavTree nodes={nodes} />
  </nav>
</div>

<script>
  import '@eqtylab/docs/scripts/eq-nav-drawer.ts';
</script>
