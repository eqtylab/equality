---
/**
 * Mobile navigation, below `lg` where the sidebar is hidden.
 *
 * The Popover API, not a custom element. With no JavaScript it opens and closes,
 * shuts on Escape or a click outside, returns focus to the button, and paints above
 * everything else. It also avoids `DialogContainer`'s focus-restoration bug.
 */
import CONFIG from 'virtual:eqty-docs/config';
import type { NavNode } from '@eqtylab/docs/types';
import { Icon } from '@eqtylab/equality';

import type { SwitcherData } from '../lib/versions-ui.ts';
import LinkIcon from './LinkIcon.astro';
import NavTree from './NavTree.astro';

interface Props {
  nodes: NavNode[];
  /** Absent when versioning is dormant or off. */
  switcher?: SwitcherData;
}
const { nodes, switcher } = Astro.props;

// data-current carries the selected state, so the rule cannot be a plain utility.
const versionLink =
  'text-text-secondary hover:text-text-primary mb-0.5 flex items-center rounded-md px-2 py-1 text-sm no-underline data-[current]:text-text-primary data-[current]:font-medium';

const versions = switcher ? [switcher.latest, ...switcher.groups.flatMap((g) => g.items)] : [];
const currentVersion = versions.find((v) => v.current) ?? switcher?.latest;
---

{
  /*
    A popover is `display:none` until opened, so no `hidden` is needed, and above lg
    the sidebar is back so it must never open. Resetting the UA's margin, border and
    padding is required: a popover is not a plain box.

    The `::backdrop` pair is the scrim. It comes with the popover, so there is no extra
    element and no scrim selector reaching into another package.
  */
}
<div
  id="eq-nav-drawer"
  popover
  class="bg-background-raised border-border-raised fixed inset-y-0 left-0 m-0 h-full w-[min(20rem,84vw)] overflow-y-auto border-r p-4 lg:hidden [&::backdrop]:bg-background/50 [&::backdrop]:backdrop-blur-[3px]"
  data-eq-chrome
  data-pagefind-ignore
>
  <nav class="block" aria-label="Documentation">
    {
      /* Below lg the header bar has no room for the switcher, so the versions live here. */
    }
    {
      /* Closed by default. Twenty-six of these at `minor`, and more at `patch`: left open they
         push the navigation the reader actually came for off the screen. `<details>` because
         the sidebar's groups already are, so this is the same gesture twice rather than a
         third one, and it needs no script inside a popover that deliberately has none. */
    }
    {
      switcher && currentVersion && (
        <details class="border-border-raised mb-2 block border-b pb-2" data-eq-versions>
          <summary class="text-text-secondary hover:text-text-primary focus-ring flex cursor-pointer select-none items-center justify-between rounded-md px-2 py-1.5 text-sm no-underline [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2">
              <span class="text-xs font-medium uppercase">Version</span>
              <span class="text-text-primary font-medium">{currentVersion.label}</span>
            </span>
            <span class="shrink-0 transition-transform duration-200 [details[open]>summary_&]:rotate-90">
              <Icon icon="ChevronRight" size="xs" />
            </span>
          </summary>
          {/* Capped rather than unbounded: the drawer scrolls too, and two nested scrolls
              with no limit means the list can still swallow the whole panel. */}
          <div class="mt-1 max-h-[40vh] overflow-y-auto">
            {versions.map((item) => (
              <a class={versionLink} href={item.href} data-current={item.current ? '' : undefined}>
                {item.label}
              </a>
            ))}
          </div>
        </details>
      )
    }
    {
      CONFIG.header.links.map((link) => (
        <a
          class="text-text-secondary hover:text-text-primary mb-1 flex max-h-10 items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium no-underline"
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.icon && <LinkIcon icon={link.icon} />}
          <span>{link.label}</span>
          {link.external && <Icon icon="ArrowUpRight" size="xs" />}
        </a>
      ))
    }
    <NavTree nodes={nodes} />
  </nav>
</div>

<script>
  import '@eqtylab/docs/scripts/eq-nav-drawer.ts';
</script>
