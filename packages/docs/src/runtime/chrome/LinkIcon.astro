---
import CONFIG from 'virtual:eqty-docs/config';

interface Props {
  icon: string;
}
const { icon } = Astro.props;
const svg = CONFIG.icons[icon];
if (!svg) {
  throw new Error(
    `[@eqtylab/docs] Icon "${icon}" is not named anywhere in the docs config. Icons are looked up from the config when the site starts, so name it there, for example in header.links or footer.links.`
  );
}
---

<svg class="block size-4 shrink-0" viewBox={svg.viewBox} aria-hidden="true" set:html={svg.body} />
