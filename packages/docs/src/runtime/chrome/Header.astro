---
import CONFIG from 'virtual:eqty-docs/config';
import { withBase } from '@eqtylab/docs/paths';
import { Icon } from '@eqtylab/equality';
import GlobalSearch from './GlobalSearch.tsx';
import ThemeToggle from './ThemeToggle.tsx';
import styles from './Header.module.css';

interface Props {
  /** First page of each top-level section. Shown before a reader has any history. */
  suggested?: Array<{ label: string; href: string }>;
  /** False when the page forwards a consumer-provided `search` slot. */
  showSearch?: boolean;
}

const { showSearch = true, suggested = [] } = Astro.props;

const paths = { base: import.meta.env.BASE_URL, pathPrefix: CONFIG.pathPrefix };
const homeHref = withBase(CONFIG.pathPrefix ? `/${CONFIG.pathPrefix}/` : '/', {
  base: import.meta.env.BASE_URL,
});
---

<header class={styles.header} data-eq-chrome data-pagefind-ignore>
  <div class={styles.inner}>
    <a
      class={styles.brand}
      href={homeHref}
      aria-label={CONFIG.logo?.replacesTitle ? CONFIG.logo.alt || CONFIG.title : undefined}
    >
      {
        CONFIG.logo && (
          <Fragment>
            <img
              class={styles.logo}
              src={withBase(CONFIG.logo.src, paths)}
              alt={CONFIG.logo.alt}
              height="24"
            />
            {CONFIG.logo.compact && (
              <img
                class={styles.logoCompact}
                src={withBase(CONFIG.logo.compact, paths)}
                alt=""
                aria-hidden="true"
                height="24"
              />
            )}
          </Fragment>
        )
      }
      {!CONFIG.logo?.replacesTitle && <span class={styles.title}>{CONFIG.title}</span>}
    </a>

    <div class={styles.search}>
      <slot name="search" />
      {
        /* client:only: with no JS there is no search, and client:load would leave a dead control. */
        showSearch && CONFIG.search.provider !== 'none' && <GlobalSearch suggested={suggested} client:only="react" />
      }
    </div>

    <div class={styles.actions}>
      <slot name="versions" />
      <div class={styles.navLinks}>
        {CONFIG.header.links.map((link) => (
          <a
            class={styles.navLink}
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.icon && <Icon icon={link.icon} size="sm" />}
            <span class={styles.navLinkLabel}>{link.label}</span>
          </a>
        ))}
      </div>
      {CONFIG.header.showThemeToggle && <ThemeToggle client:load />}
      {
        /* popovertarget: the platform handles open, close, Escape, light dismiss and
           focus return. Hidden above lg, where the sidebar is back. */
      }
      <button
        class={styles.navTrigger}
        type="button"
        popovertarget="eq-nav-drawer"
        aria-label="Open navigation"
      >
        <Icon icon="Menu" size="sm" />
      </button>
    </div>
  </div>
</header>
