---
/** Header + sidebar | prose | TOC. The `doc` template. */
import type { NavNode, TocNode } from '@eqtylab/docs/types';
import CONFIG from 'virtual:eqty-docs/config';
import DocsShell from './DocsShell.astro';
import AppFooter from '../chrome/AppFooter.astro';
import Header from '../chrome/Header.astro';
import NavDrawer from '../chrome/NavDrawer.astro';
import Sidebar from '../chrome/Sidebar.astro';
import TableOfContents from '../chrome/TableOfContents.astro';
import VersionBanner from '../chrome/VersionBanner.astro';
import type { SwitcherData } from '../lib/versions-ui.ts';

interface Props {
  title: string;
  description?: string;
  nav: NavNode[];
  toc: TocNode[];
  showToc?: boolean;
  splash?: boolean;
  version?: string;
  switcher?: SwitcherData;
  noIndex?: boolean;
  canonical?: string;
  latestHref?: string;
  latestLabel?: string;
}

const {
  title,
  description,
  nav,
  toc,
  showToc = true,
  splash = false,
  version,
  switcher,
  noIndex,
  canonical,
  latestHref,
  latestLabel,
} = Astro.props;

// The title entry keeps the outline on a page with no headings. Not "Overview": many pages open
// with a heading of that name.
const outline: TocNode[] = [{ slug: '_top', text: title, depth: 1, children: [] }, ...toc];

// A section's own index page if it has one, else its first child. Never the sidebar repeated.
const suggested = nav
  .map((node) => ({ label: node.label, href: node.href ?? node.children?.[0]?.href }))
  .filter((item): item is { label: string; href: string } => !!item.href)
  .slice(0, 4);
---

<DocsShell
  title={title}
  description={description}
  noIndex={noIndex}
  canonical={canonical}
  version={version}
>
  {/* A prop, not slot fallback: Astro registers a named slot at compile time, so a forwarded
      slot always counts as filled and the fallback never runs. */}
  <Header showSearch={!Astro.slots.has('search')} suggested={suggested}>
    <slot name="search" slot="search" />
    <slot name="versions" slot="versions" />
  </Header>
  <NavDrawer nodes={nav} switcher={switcher} />
  <div class="flex items-start">
    {!splash && <Sidebar nodes={nav} switcher={switcher} />}
    {/* At least a screen tall, so a short page still keeps the app footer at the bottom. */}
    <div class="flex min-h-[calc(100vh-var(--eq-docs-header-height))] min-w-0 flex-1 flex-col">
      <main
        class="mx-auto flex w-full flex-1 min-w-0 max-w-[calc(var(--eq-docs-content-max)+var(--eq-docs-toc-width)+8rem)] items-start gap-12 px-6 pt-10 data-[splash]:max-w-none xl:gap-16"
        data-splash={splash ? '' : undefined}
      >
        <div class="min-w-0 flex-1 [&>.eq-prose]:max-w-[var(--eq-docs-content-max)]">
          {/* Taller than any offset, so the browser clamps #_top to the very top. */}
          <span id="_top" class="block scroll-mt-[100vh]" aria-hidden="true"></span>
          {
            version && latestHref && latestLabel && (
              <VersionBanner version={version} latestLabel={latestLabel} latestHref={latestHref} />
            )
          }
          <slot />
        </div>
        {!splash && showToc && <TableOfContents items={outline} />}
      </main>
      <AppFooter />
    </div>
  </div>
</DocsShell>
