---
/**
 * Renders a fenced code block through Equality's `CodeBlock`.
 *
 * The source, language and optional `title=` come from `rehypeCodeFence`, which
 * lifts them off the hast onto this `<pre>`. Reading them as props rather than
 * re-parsing the rendered slot is what keeps `astro dev` and a production build
 * identical -- slot HTML is escaped in one and raw in the other.
 */
import CodeFence from './CodeFence.astro';

interface Props {
  'data-code'?: string;
  'data-language'?: string;
  'data-title'?: string;
}

const props = Astro.props as Props;
const code = props['data-code'] ?? '';
const lang = props['data-language'] ?? 'text';
const title = props['data-title'];
---

<CodeFence code={code} lang={lang} title={title} />
