---
import { isExternalHref } from '@eqtylab/docs/paths';

interface Props {
  href?: string;
  [key: string]: unknown;
}

const { href = '', ...rest } = Astro.props;
const external = isExternalHref(href);
---

<a
  href={href}
  class="text-inherit"
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <slot />
</a>
